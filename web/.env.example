# Template only. Create web/.env.local from this file.
# Never commit real credentials. Public URL/key must belong to the NEW English project.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Do NOT add NEXT_PUBLIC_ to any of these.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL_PRIMARY=gemini-2.5-flash
GEMINI_MODEL_FALLBACK=
AI_ENABLED=false
AI_DAILY_BATCHES_PER_USER=5
AI_OPERATIONS_PER_MINUTE_PER_USER=2
AI_GLOBAL_DAILY_CALL_LIMIT=100
AI_GLOBAL_MINUTE_CALL_LIMIT=10
AI_USER_DAILY_CALL_LIMIT=10
APP_ENV=development
DEMO_MODE=false

# Used by manual content seeding, not ordinary runtime.
SEED_OWNER_ID=
