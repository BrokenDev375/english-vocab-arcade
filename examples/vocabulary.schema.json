{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "English Vocab Arcade handoff seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "sets"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "source",
        "license",
        "reviewStatus",
        "reviewer",
        "createdOn",
        "notes"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "reviewStatus": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "createdOn": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "language",
          "cefrLevel",
          "topic",
          "isPublic",
          "cards"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 1000
          },
          "language": {
            "const": "en"
          },
          "cefrLevel": {
            "enum": [
              "A1",
              "A2",
              "B1",
              "mixed"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "isPublic": {
            "type": "boolean"
          },
          "cards": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "term",
                "meaningVi",
                "partOfSpeech",
                "ipa",
                "cefrLevel",
                "exampleEn",
                "exampleVi",
                "acceptedAnswers",
                "position",
                "reviewStatus"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "term": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "meaningVi": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "partOfSpeech": {
                  "enum": [
                    "noun",
                    "verb",
                    "adjective",
                    "adverb",
                    "phrase",
                    "other"
                  ]
                },
                "ipa": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 120
                },
                "cefrLevel": {
                  "enum": [
                    "A1",
                    "A2",
                    "B1"
                  ]
                },
                "exampleEn": {
                  "type": "string",
                  "maxLength": 500
                },
                "exampleVi": {
                  "type": "string",
                  "maxLength": 500
                },
                "acceptedAnswers": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "position": {
                  "type": "integer",
                  "minimum": 0
                },
                "reviewStatus": {
                  "enum": [
                    "draft",
                    "reviewed"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
